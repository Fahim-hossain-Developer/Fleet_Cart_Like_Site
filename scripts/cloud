#!/usr/bin/env bash
# Optional managed-cloud Docker helper; normal local PHP/Composer also work.
set -euo pipefail
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cloud_args=()
if [[ "${1:-}" == serve ]]; then
    shift
    cloud_args+=(--publish 8000:8000)
    set -- php artisan serve --host=0.0.0.0 "$@"
fi
trust_bundle="${DEV_CA_BUNDLE:-/etc/ssl/certs/ca-certificates.crt}"
if getent hosts proxy >/dev/null 2>&1; then
    cloud_args+=(--add-host "proxy:$(getent hosts proxy | awk 'NR==1 {print $1}')")
fi
mkdir -p /workspace/.composer-cache
exec docker run --rm --user "$(id -u):$(id -g)" "${cloud_args[@]}" \
    -e XDG_CONFIG_HOME=/tmp/commerce-config -e COMPOSER_HOME=/tmp/composer -e COMPOSER_CAFILE=/run/ca.pem \
    -e GIT_SSL_CAINFO=/run/ca.pem -e SSL_CERT_FILE=/run/ca.pem -e NODE_EXTRA_CA_CERTS=/run/ca.pem \
    -v "$trust_bundle:/run/ca.pem:ro" -v /workspace/.composer-cache:/tmp/composer \
    -v "$repo_root:/app" -w /app commerce-php83 "$@"
